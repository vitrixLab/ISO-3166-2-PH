{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ISO 3166-2:PH verified mapping record",
  "type": "object",
  "required": ["iso_3166_2", "name", "subdivision_type", "source", "verified_at", "status"],
  "properties": {
    "iso_3166_2": {"type": "string", "pattern": "^PH-[A-Z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "subdivision_type": {"type": "string", "minLength": 1},
    "parent_iso_3166_2": {"type": ["string", "null"]},
    "psgc_code": {"type": ["string", "null"]},
    "valid_from": {"type": ["string", "null"], "format": "date"},
    "valid_to": {"type": ["string", "null"], "format": "date"},
    "source": {"type": "string", "minLength": 1},
    "source_published_at": {"type": ["string", "null"], "format": "date"},
    "verified_at": {"type": "string", "format": "date-time"},
    "status": {"type": "string", "enum": ["current", "historical", "deprecated", "unverified"]}
  },
  "additionalProperties": false
}
